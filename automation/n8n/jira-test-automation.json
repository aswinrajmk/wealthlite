    {
      "name": "Search labelled tests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "https://aswinnrk.atlassian.net/rest/api/3/search/jql",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "jql",
              "value": "project = KAN AND issuetype = Test AND labels in (smoke, regression) AND labels not in (auto-pending, auto-queued, auto-pr-open, automated, auto-failed, auto-rejected) ORDER BY created ASC"
            },
            {
              "name": "fields",
              "value": "summary,description,labels,issuelinks"
            },
            {
              "name": "maxResults",
              "value": "50"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "<set-in-n8n>",
          "name": "Jira WealthLite"
        }
      }
    },
    {
      "name": "Group by story",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "\n// Group the labelled Test issues by their story (Test --Tests--> Story) and take the oldest story only:\n// one story per execution, because each run pauses on its own approval link.\nfunction adfText(node) {\n  if (!node) return '';\n  if (node.type === 'text') return node.text || '';\n  if (node.type === 'hardBreak') return '\\n';\n  const inner = (node.content || []).map(adfText).join('');\n  if (node.type === 'listItem') return '- ' + inner;\n  if (['paragraph', 'heading', 'codeBlock', 'blockquote'].includes(node.type)) return inner + '\\n';\n  return inner;\n}\n// Folder under tests/ui for a local draft, guessed from the story title (Claude Code picks its own).\nfunction featureOf(title) {\n  const t = title.toLowerCase();\n  if (/sign|log ?in|log ?out|password|auth/.test(t)) return 'auth';\n  if (/holding|portfolio|total|value/.test(t)) return 'portfolio';\n  return 'stories';\n}\nconst byStory = new Map();\nfor (const issue of $input.first().json.issues || []) {\n  const link = (issue.fields.issuelinks || []).find((l) => l.type.name === 'Tests' && l.outwardIssue);\n  if (!link) continue; // a Test with no story cannot be traced, so it is skipped\n  const story = link.outwardIssue;\n  const entry = byStory.get(story.key) ||\n    { story: story.key, title: story.fields.summary, feature: featureOf(story.fields.summary), tests: [] };\n  const suite = issue.fields.labels.includes('smoke') ? 'smoke' : 'regression';\n  entry.tests.push({ key: issue.key, suite, title: issue.fields.summary.replace(/^\\[KAN-\\d+\\]\\s*/, ''),\n    description: adfText(issue.fields.description).trim() });\n  byStory.set(story.key, entry);\n}\nconst first = [...byStory.values()][0];\nif (!first) return [];\nconst lines = first.tests.map((t) => `\u2022 ${t.key} (${t.suite}) ${t.title}`);\nconst text = [`\ud83e\udd16 Automate ${first.tests.length} test(s) for ${first.story}: ${first.title}`, '', ...lines,\n  '', `${\"https://aswinnrk.atlassian.net\"}/browse/${first.story}`].join('\\n').slice(0, 3800);\nreturn [{ json: { ...first, keys: first.tests.map((t) => t.key).join(','), text } }];\n"
      }
    },
    {
      "name": "Split tests (claim)",
