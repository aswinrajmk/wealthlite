        "jsCode": "\n// One item per framework file to read from GitHub.\nreturn [\"docs/CONVENTIONS.md\", \"src/fixtures/index.ts\", \"src/fixtures/pages.fixture.ts\", \"src/fixtures/auth.fixture.ts\", \"src/pages/LoginPage.ts\", \"src/pages/PortfolioPage.ts\", \"src/components/AppHeader.ts\", \"src/components/HoldingsTable.ts\", \"src/data/users.ts\", \"tests/ui/auth/kan-6-sign-out.spec.ts\"].map((path) => ({ json: { path } }));\n"
