{
  "name": "Jira Story Intake",
  "nodes": [
    {
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "name": "Search new stories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "https://aswinnrk.atlassian.net/rest/api/3/search/jql",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "jql",
              "value": "project = KAN AND issuetype = Story AND (labels IS EMPTY OR labels NOT IN (ai-new, ai-analysing, ai-analysis-approved, ai-tests-approved, ai-done, ai-rejected)) ORDER BY created ASC"
            },
            {
              "name": "fields",
              "value": "summary,description,issuetype,labels"
            },
            {
              "name": "maxResults",
              "value": "1"
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "<set-in-n8n>",
          "name": "Jira WealthLite"
        }
      }
    },
    {
      "name": "Flatten stories",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "\n// Turn Jira's search response into one item per story, with the ADF description as plain text.\nfunction adfText(node) {\n  if (!node) return '';\n  if (node.type === 'text') return node.text || '';\n  if (node.type === 'hardBreak') return '\\n';\n  const inner = (node.content || []).map(adfText).join('');\n  if (node.type === 'listItem') return '- ' + inner;\n  if (['paragraph', 'heading', 'codeBlock', 'blockquote'].includes(node.type)) return inner + '\\n';\n  return inner;\n}\nconst site = 'https://aswinnrk.atlassian.net';\nconst out = [];\nfor (const item of $input.all()) {\n  for (const issue of item.json.issues || []) {\n    out.push({ json: {\n      key: issue.key,\n      summary: issue.fields.summary,\n      description: adfText(issue.fields.description).trim() || '(no description)',\n      url: `${site}/browse/${issue.key}`,\n    }});\n  }\n}\nreturn out;\n"
      }
    },
    {
      "name": "Claim story (label ai-new)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "PUT",
        "url": "=https://aswinnrk.atlassian.net/rest/api/3/issue/{{ $json.key }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"update\":{\"labels\":[{\"add\":\"ai-new\"}]}}",
        "options": {}
      },
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "<set-in-n8n>",
          "name": "Jira WealthLite"
        }
      }
    },
    {
      "name": "Qwen analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'qwen3.5:2b',\n  stream: false,\n  think: false,\n  options: { temperature: 0.2 },\n  format: {\n    type: 'object',\n    properties: {\n      summary: { type: 'string' },\n      ambiguities: { type: 'array', items: { type: 'string' } },\n      risks: { type: 'array', items: { type: 'string' } }\n    },\n    required: ['summary', 'ambiguities', 'risks']\n  },\n  messages: [\n    { role: 'system', content: 'You are a senior QA analyst. Analyse the user story and its acceptance criteria. Reply only with JSON: a one-sentence summary, ambiguities (missing or unclear details), and risks.' },\n    { role: 'user', content: 'Story ' + $('Flatten stories').item.json.key + ': ' + $('Flatten stories').item.json.summary + '\\n\\n' + $('Flatten stories').item.json.description }\n  ]\n}) }}",
        "options": {
          "timeout": 180000
        }
      }
    },
    {
      "name": "Format message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\n// Parse Qwen's JSON and build the Telegram message for this story.\nconst story = $('Flatten stories').item.json;\nlet a;\ntry { a = JSON.parse($json.message.content); }\ncatch (e) { a = { summary: '(could not parse model output)', ambiguities: [], risks: [] }; }\nconst list = (xs) => (xs && xs.length ? xs.map((x) => '\u2022 ' + x).join('\\n') : '\u2022 none');\nconst text = [\n  `\ud83c\udd95 New story ${story.key}: ${story.summary}`,\n  story.url,\n  '',\n  `Summary: ${a.summary}`,\n  '',\n  'Ambiguities:', list(a.ambiguities),\n  '',\n  'Risks:', list(a.risks),\n].join('\\n').slice(0, 3800);\nreturn { json: { ...story, analysis: a, text } };\n"
      }
    },
    {
      "name": "Ask analysis approval",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "chatId": "<TELEGRAM_CHAT_ID>",
        "text": "={{ $json.text }}\n\nApprove this analysis? (buttons work from Telegram on this Mac)",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "\u2705 Approve",
                    "additionalFields": {
                      "url": "={{ ((u) => u + (u.includes('?') ? '&' : '?') + 'd=approve&s=analysis')($execution.resumeUrl.replace('//localhost', '//127.0.0.1')) }}"
                    }
                  },
                  {
                    "text": "\u274c Reject",
                    "additionalFields": {
                      "url": "={{ ((u) => u + (u.includes('?') ? '&' : '?') + 'd=reject&s=analysis')($execution.resumeUrl.replace('//localhost', '//127.0.0.1')) }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "<set-in-n8n>",
          "name": "Telegram aswinqabot"
        }
      }
    },
    {
      "name": "Wait for analysis decision",
