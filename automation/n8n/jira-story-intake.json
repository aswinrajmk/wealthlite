    {
      "name": "Prepare test issues",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3740,
        -320
      ],
      "parameters": {
        "jsCode": "\n// One Jira 'Test' issue per approved case, linked to the story with 'Tests' (story is tested by test).\nconst story = $('Format message').first().json;\nconst cases = $('Format test cases').first().json.cases;\nconst p = (t) => ({ type: 'paragraph', content: [{ type: 'text', text: String(t || '-') }] });\nconst h = (t) => ({ type: 'heading', attrs: { level: 3 }, content: [{ type: 'text', text: t }] });\nreturn cases.map((c) => ({ json: { title: c.title, payload: {\n  fields: {\n    project: { key: 'KAN' },\n    issuetype: { id: '10010' },\n    summary: `[${story.key}] ${c.title}`.slice(0, 250),\n    labels: ['ai-generated', `tc-${c.type}`],\n    description: { type: 'doc', version: 1, content: [\n      p(`Type: ${c.type} | Covers: ${c.criterion}`),\n      h('Preconditions'), p(c.preconditions),\n      h('Steps'),\n      { type: 'orderedList', content: (c.steps || []).map((s) => ({ type: 'listItem', content: [p(s)] })) },\n      h('Expected result'), p(c.expected),\n    ] },\n  },\n  update: { issuelinks: [{ add: { type: { name: 'Tests' }, outwardIssue: { key: story.key } } }] },\n} } }));\n"
      }
    },
    {
      "name": "Create Test issue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3960,
        -320
      ],
      "parameters": {
        "method": "POST",
        "url": "https://aswinnrk.atlassian.net/rest/api/3/issue",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
